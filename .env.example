# Optional GitHub personal access token (raises API rate limit from 60 to 5000 req/h).
# No scopes needed for public data. Export before starting the backend:
#   export GITHUB_TOKEN=ghp_xxx
GITHUB_TOKEN=

# Optional "Sign in with GitHub" (OAuth2). Create an OAuth app at
# https://github.com/settings/developers with Authorization callback URL:
#   http://localhost:8080/login/oauth2/code/github
# (must match exactly — Spring builds the redirect_uri on the backend port).
# Without these the app still runs; only the sign-in flow is disabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
